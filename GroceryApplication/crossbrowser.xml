<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Crossbrowser">


	<test thread-count="5" name="ChromeTest">
		<parameter name="browsers" value="chrome"></parameter>
		<classes>
			<class name="testScript.LoginTest">
			<methods>
					<include name="varifyUserLoginWithValidCredentials"></include>
				<!--	<include name="verifyUserLoginWithInvalidCredentials"></include>-->
				</methods>
			</class>
		</classes>
	</test> 
	<test thread-count="5" name="FirefoxTest">
		<parameter name="browsers" value="Firefox"></parameter>
		<classes>
			<class name="testScript.LoginTest">
			<methods>
					<include name="varifyUserLoginWithValidCredentials"></include>
				<!--	<include name="verifyUserLoginWithInvalidCredentials"></include>-->
				</methods>
			</class>
		</classes>
	</test>
	<test thread-count="5" name="EdgeTest">
		<parameter name="browsers" value="Edge"></parameter>
		<classes>
			<class name="testScript.LoginTest">
			<methods>
					<include name="varifyUserLoginWithValidCredentials"></include>
				<!--	<include name="verifyUserLoginWithInvalidCredentials"></include>-->
				</methods>
			</class>
		</classes>
	</test>
	<!--
	Test -->
</suite> <!--
Suite -->
